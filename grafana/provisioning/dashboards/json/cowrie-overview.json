{
  "title": "Cowrie Honeypot Overview",
  "uid": "cowrie-overview",
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "exclude_ip",
        "type": "textbox",
        "label": "Exclude IP (optional)",
        "description": "Set this to your own IP to hide your own testing/admin traffic from every panel below.",
        "query": "",
        "current": { "text": "__EXCLUDE_IP_PLACEHOLDER__", "value": "__EXCLUDE_IP_PLACEHOLDER__" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Cowrie Sessions (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" | src_ip != \"$exclude_ip\" [24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Unique Attacker IPs (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "count(count by (src_ip) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" | src_ip != \"$exclude_ip\" [24h])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Malicious IPs Flagged (score > 90, 24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "count(count by (src_ip) (count_over_time({service=\"terrapot-threat-intel\"} | json | abuse_confidence_score > 90 | src_ip != \"$exclude_ip\" [24h])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Attacker Locations",
      "type": "geomap",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (country_code) (count_over_time({service=\"terrapot-threat-intel\"} | json | src_ip != \"$exclude_ip\" [$__range]))",
          "legendFormat": "{{country_code}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} }
      ],
      "options": {
        "basemap": { "type": "default" },
        "layers": [
          {
            "type": "markers",
            "config": {
              "style": {
                "size": { "fixed": 5, "min": 2, "max": 20, "field": "Value" },
                "color": { "fixed": "red" }
              }
            },
            "location": { "mode": "lookup", "lookup": "country_code" }
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Top Source IPs",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "topk(10, sum by (src_ip) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" | src_ip != \"$exclude_ip\" [$__range])))",
          "legendFormat": "{{src_ip}}",
          "refId": "A"
        }
      ],
      "options": { "orientation": "horizontal", "showValue": "always" }
    },
    {
      "id": 15,
      "title": "Top Commands Attempted",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "topk(10, sum by (input) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" | src_ip != \"$exclude_ip\" [$__range])))",
          "legendFormat": "{{input}}",
          "refId": "A"
        }
      ],
      "options": { "orientation": "horizontal", "showValue": "always" }
    },
    {
      "id": 8,
      "title": "Web Honeypot — Top Source IPs",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "topk(10, sum by (sip) (count_over_time({job=\"isc-agent\"} | json | sip != \"$exclude_ip\" [$__range])))",
          "legendFormat": "{{sip}}",
          "refId": "A"
        }
      ],
      "options": { "orientation": "horizontal", "showValue": "always" }
    },
    {
      "id": 9,
      "title": "Web Honeypot — Top Requested Paths",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "topk(10, sum by (url) (count_over_time({job=\"isc-agent\"} | json | sip != \"$exclude_ip\" [$__range])))",
          "legendFormat": "{{url}}",
          "refId": "A"
        }
      ],
      "options": { "orientation": "horizontal", "showValue": "always" }
    },
    {
      "id": 5,
      "title": "Connections Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" | src_ip != \"$exclude_ip\" [5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Web Honeypot — Requests Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"isc-agent\"} | json | sip != \"$exclude_ip\" [5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Malicious IPs — Detail (score > 90)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{service=\"terrapot-threat-intel\"} | json | abuse_confidence_score > 90 | src_ip != \"$exclude_ip\"",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "Line", "format": "json" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true, "tsNs": true, "id": true, "labels": true,
              "labelTypes": true, "Time": true, "total_reports": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Threat Intel — AbuseIPDB Enrichment",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{service=\"terrapot-threat-intel\"} | json | src_ip != \"$exclude_ip\"",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "Line", "format": "json" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true, "tsNs": true, "id": true, "labels": true,
              "labelTypes": true, "Time": true, "total_reports": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Commands Typed by Attackers",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 46 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" | src_ip != \"$exclude_ip\" | line_format \"{{.src_ip}} ran: {{.input}}\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Web Honeypot — Raw Request Log",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 56 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{job=\"isc-agent\"} | json | sip != \"$exclude_ip\" | line_format \"{{.sip}} {{.method}} {{.url}} UA={{.useragent}}\"",
          "refId": "A"
        }
      ]
    }
  ]
}
